{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@utils/*": ["./utils/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": [
    "**/*.js",
    "src/**/*.js",
    "utils/**/*.js", 
    "config/**/*.js",
    "*.js"
  ],
  "exclude": ["node_modules"]
}